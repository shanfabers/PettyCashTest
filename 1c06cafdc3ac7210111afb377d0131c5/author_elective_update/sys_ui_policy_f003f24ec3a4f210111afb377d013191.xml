    (function() {
        var empId = g_form.getValue('employeename');
        if (!empId) return;

        // 1) Get the PettyCashUsers record referenced by 'employeename'
        g_form.getReference('employeename', function(emp) {
            if (!emp) return;

            // --- CASE A: manager is a Reference → sys_user (recommended) ---
            if (emp.manager) {
                // Set the manager ref (value=sys_id, display=employee’s manager name if provided)
                // If PettyCashUsers.manager_name doesn't exist, the 3rd arg can be omitted.
                g_form.setValue('manager', emp.manager, emp.manager_name);

                // 2) Now fetch the sys_user to get a guaranteed email value
                g_form.getReference('manager', function(mgr) {
                    if (mgr && mgr.email) {
                        g_form.setValue('manager_email', mgr.email);
                    } else if (emp.manager_email) {
                        // fallback to PettyCashUsers.manager_email if present
                        g_form.setValue('manager_email', emp.manager_email);
                    } else {
                        g_form.clearValue('manager_email');
                    }
                });
            } else {
                // No manager on the employee record
                g_form.clearValue('manager');
                // Try PettyCashUsers.manager_email if you store it there without manager ref
                if (emp.manager_email) g_form.setValue('manager_email', emp.manager_email);
                else g_form.clearValue('manager_email');
            }
        });
    })();


}]]></script_true>
