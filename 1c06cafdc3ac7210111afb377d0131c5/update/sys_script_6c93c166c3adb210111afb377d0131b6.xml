        <script><![CDATA[//(function executeRule(current, previous /*null when async*/) {

// Add your code here

//})(current, previous);

(function() {
    // Put current user + manager details into g_scratchpad
    var uid = gs.getUserID();
    var u = new GlideRecord('sys_user');
    if (u.get(uid)) {
        g_scratchpad.emp = u.getUniqueValue(); // sys_id of current user
        g_scratchpad.emp_email = u.getValue('email') || '';
        var mid = u.getValue('manager');

        g_scratchpad.manager = mid || '';
        g_scratchpad.manager_email = '';

        if (mid) {
            var m = new GlideRecord('sys_user');
            if (m.get(mid)) {
                g_scratchpad.manager_email = m.getValue('email') || '';
            }
        }
    }
})();]]></script>
