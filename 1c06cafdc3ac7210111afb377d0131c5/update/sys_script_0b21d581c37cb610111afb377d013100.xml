        <script><![CDATA[(function executeRule(current, previous) {
    function toNum(v) {
        var n = parseFloat(v);
        return isNaN(n) ? 0 : n;
    }

    function r2(n) {
        return Math.round(n * 100) / 100;
    }

    // Run on insert, or if any input changed
    var changed = !previous ||
        current.amount.changes() ||
        current.amount_reimbursed.changes() ||
        current.total_line_amount.changes();
    if (!changed) return;

    var amount = toNum(current.getValue('amount'));
    var reimbursed = toNum(current.getValue('amount_reimbursed'));
    var totalLines = toNum(current.getValue('total_line_amount'));

    var balance = r2(amount + reimbursed - totalLines);
    current.setValue('amount_balance', balance);

})(current, previous);]]></script>
