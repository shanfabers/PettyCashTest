        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

  // Default employee to logged-in user if empty
  if (!current.employee_name) current.employee_name = gs.getUserID();

  var u = new GlideRecord('sys_user');
  if (u.get(current.employee_name)) {

    if (!current.employee_email && u.email)
      current.employee_email = u.email;

    if (!current.manager && u.manager)
      current.manager = u.manager;

    if (!current.manager_email && u.manager) {
      var m = new GlideRecord('sys_user');
      if (m.get(u.manager) && m.email)
        current.manager_email = m.email;
    }
  }

})(current, previous);
]]></script>
