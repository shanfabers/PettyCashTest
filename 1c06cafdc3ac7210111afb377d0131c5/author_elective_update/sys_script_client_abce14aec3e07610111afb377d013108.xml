        <name>Auto-fill Email - Table PettyCashMain</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
    if (isLoading || newValue == '') {
        return;
    }

    g_form.getReference('employeename', function(emp) {
        if (emp && emp.email) {
            g_form.setValue('employee_email', emp.email);
        } else {
            g_form.setValue('employee_email', '');
        }
    });

}]]></script>
